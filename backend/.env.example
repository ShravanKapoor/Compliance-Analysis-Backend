PORT=3000
# Frontend origin allowed by CORS (Vite dev server default)
CLIENT_URL=http://localhost:5173
NODE_ENV=development

MONGO_URL=
JWT_SECRET=

CLOUDINARY_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_SECRET=

HUGGINGFACE_API_KEY=

QDRANT_URL=
QDRANT_API_KEY=

# Compliance engine: when set, Claude judges each control against the
# product's evidence. Without it, an evidence-similarity check is used and
# reports are marked "under_review".
ANTHROPIC_API_KEY=
# Optional: model override (default claude-opus-5-5)
CLAUDE_MODEL=
# Optional: "claude" or "similarity" to force one method
COMPLIANCE_ASSESSOR=
